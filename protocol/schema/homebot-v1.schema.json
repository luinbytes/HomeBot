{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtocolV1Schema",
  "description": "Root exported to the committed machine-readable JSON Schema.",
  "type": "object",
  "properties": {
    "approval_decision_request": {
      "$ref": "#/$defs/ApprovalDecisionRequest"
    },
    "attachment": {
      "$ref": "#/$defs/Attachment"
    },
    "bot_mutation_request": {
      "$ref": "#/$defs/BotMutationRequest"
    },
    "bot_response": {
      "$ref": "#/$defs/BotResponse"
    },
    "chat_timeline_response": {
      "$ref": "#/$defs/ChatTimelineResponse"
    },
    "client_message": {
      "$ref": "#/$defs/ClientMessage"
    },
    "create_attachment_request": {
      "$ref": "#/$defs/CreateAttachmentRequest"
    },
    "create_attachment_response": {
      "$ref": "#/$defs/CreateAttachmentResponse"
    },
    "create_bot_request": {
      "$ref": "#/$defs/CreateBotRequest"
    },
    "create_direct_chat_request": {
      "$ref": "#/$defs/CreateDirectChatRequest"
    },
    "create_direct_chat_response": {
      "$ref": "#/$defs/CreateDirectChatResponse"
    },
    "error": {
      "$ref": "#/$defs/ErrorEnvelope"
    },
    "finalize_attachment_request": {
      "$ref": "#/$defs/FinalizeAttachmentRequest"
    },
    "message_mutation_request": {
      "$ref": "#/$defs/MessageMutationRequest"
    },
    "send_message_request": {
      "$ref": "#/$defs/SendMessageRequest"
    },
    "send_message_response": {
      "$ref": "#/$defs/SendMessageResponse"
    },
    "server_event": {
      "$ref": "#/$defs/ServerEvent"
    },
    "update_bot_request": {
      "$ref": "#/$defs/UpdateBotRequest"
    }
  },
  "required": [
    "client_message",
    "server_event",
    "error",
    "create_attachment_request",
    "create_attachment_response",
    "finalize_attachment_request",
    "attachment",
    "create_bot_request",
    "update_bot_request",
    "bot_mutation_request",
    "bot_response",
    "create_direct_chat_request",
    "create_direct_chat_response",
    "send_message_request",
    "send_message_response",
    "message_mutation_request",
    "chat_timeline_response",
    "approval_decision_request"
  ],
  "$defs": {
    "ActivityStatus": {
      "type": "string",
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "ActivitySummary": {
      "type": "object",
      "properties": {
        "chat_id": {
          "type": "string",
          "format": "uuid"
        },
        "detail": {
          "type": "string"
        },
        "finished_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "requires_attention": {
          "type": "boolean"
        },
        "started_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "status": {
          "$ref": "#/$defs/ActivityStatus"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "chat_id",
        "title",
        "detail",
        "status",
        "requires_attention",
        "started_at_ms"
      ]
    },
    "ApprovalDecisionRequest": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "boolean"
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "allow"
      ]
    },
    "ApprovalStatus": {
      "type": "string",
      "enum": [
        "pending",
        "allowed",
        "denied",
        "expired"
      ]
    },
    "ApprovalSummary": {
      "type": "object",
      "properties": {
        "chat_id": {
          "type": "string",
          "format": "uuid"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "decided_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "detail": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "message_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "status": {
          "$ref": "#/$defs/ApprovalStatus"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "chat_id",
        "title",
        "detail",
        "status",
        "created_at_ms"
      ]
    },
    "Attachment": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "media_type": {
          "type": "string"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "filename",
        "media_type",
        "size_bytes",
        "sha256"
      ]
    },
    "BotAdvancedSettings": {
      "type": "object",
      "properties": {
        "permission_profile": {
          "$ref": "#/$defs/BotPermissionProfile"
        },
        "provider_profile_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "permission_profile"
      ]
    },
    "BotAttention": {
      "type": "string",
      "enum": [
        "none",
        "working",
        "needs_approval",
        "failed"
      ]
    },
    "BotColor": {
      "type": "string",
      "enum": [
        "violet",
        "blue",
        "green",
        "orange",
        "rose",
        "slate"
      ]
    },
    "BotMutationRequest": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key"
      ]
    },
    "BotPermissionProfile": {
      "type": "string",
      "enum": [
        "read_only",
        "ask_before_changes",
        "trusted"
      ]
    },
    "BotProviderStatus": {
      "type": "string",
      "enum": [
        "not_configured",
        "ready",
        "unavailable"
      ]
    },
    "BotResponse": {
      "type": "object",
      "properties": {
        "bot": {
          "$ref": "#/$defs/BotSummary"
        }
      },
      "additionalProperties": false,
      "required": [
        "bot"
      ]
    },
    "BotShape": {
      "type": "string",
      "enum": [
        "circle",
        "rounded_square",
        "hexagon"
      ]
    },
    "BotSummary": {
      "type": "object",
      "properties": {
        "advanced": {
          "$ref": "#/$defs/BotAdvancedSettings"
        },
        "archived": {
          "type": "boolean"
        },
        "attention": {
          "$ref": "#/$defs/BotAttention"
        },
        "color": {
          "$ref": "#/$defs/BotColor"
        },
        "description": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "provider": {
          "$ref": "#/$defs/BotProviderStatus"
        },
        "shape": {
          "$ref": "#/$defs/BotShape"
        },
        "title": {
          "type": "string"
        },
        "unread_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "title",
        "description",
        "shape",
        "color",
        "archived",
        "unread_count",
        "attention",
        "provider",
        "advanced"
      ]
    },
    "ChatSummary": {
      "type": "object",
      "properties": {
        "bot_id": {
          "type": "string",
          "format": "uuid"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "last_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "queued_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "running": {
          "type": "boolean"
        },
        "title": {
          "type": "string"
        },
        "unread_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "bot_id",
        "unread_count",
        "running",
        "queued_count",
        "last_sequence"
      ]
    },
    "ChatTimelineResponse": {
      "type": "object",
      "properties": {
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivitySummary"
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ApprovalSummary"
          }
        },
        "boundary_sequence": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "chat": {
          "$ref": "#/$defs/ChatSummary"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessageSummary"
          }
        },
        "queued_prompts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/QueuedPromptSummary"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "chat",
        "messages",
        "activities",
        "approvals",
        "queued_prompts",
        "boundary_sequence"
      ]
    },
    "ClientMessage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "client_version": {
              "type": "string"
            },
            "device_session": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "hello"
            },
            "protocol_version": {
              "type": "integer",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "resume_after": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint64",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "protocol_version",
            "client_version",
            "device_session"
          ]
        },
        {
          "type": "object",
          "properties": {
            "command": {
              "$ref": "#/$defs/Command"
            },
            "idempotency_key": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "command"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "request_id",
            "idempotency_key",
            "command"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cancel"
            },
            "operation_id": {
              "type": "string",
              "format": "uuid"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "request_id",
            "operation_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "pong"
            },
            "nonce": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "kind",
            "nonce"
          ]
        }
      ]
    },
    "Command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "create_bot"
            }
          },
          "required": [
            "type",
            "name",
            "title"
          ]
        },
        {
          "type": "object",
          "properties": {
            "chat_id": {
              "type": "string",
              "format": "uuid"
            },
            "content": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "send_message"
            }
          },
          "required": [
            "type",
            "chat_id",
            "content"
          ]
        }
      ]
    },
    "CreateAttachmentRequest": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "media_type": {
          "type": "string"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "filename",
        "media_type",
        "size_bytes",
        "sha256"
      ]
    },
    "CreateAttachmentResponse": {
      "type": "object",
      "properties": {
        "attachment_id": {
          "type": "string",
          "format": "uuid"
        },
        "expires_at_unix_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "upload_url": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "attachment_id",
        "upload_url",
        "expires_at_unix_ms"
      ]
    },
    "CreateBotRequest": {
      "type": "object",
      "properties": {
        "color": {
          "$ref": "#/$defs/BotColor"
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "permission_profile": {
          "$ref": "#/$defs/BotPermissionProfile"
        },
        "provider_profile_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "shape": {
          "$ref": "#/$defs/BotShape"
        },
        "title": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "name",
        "title",
        "shape",
        "color",
        "permission_profile"
      ]
    },
    "CreateDirectChatRequest": {
      "type": "object",
      "properties": {
        "bot_id": {
          "type": "string",
          "format": "uuid"
        },
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "bot_id"
      ]
    },
    "CreateDirectChatResponse": {
      "type": "object",
      "properties": {
        "chat": {
          "$ref": "#/$defs/ChatSummary"
        }
      },
      "additionalProperties": false,
      "required": [
        "chat"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "unauthenticated",
        "forbidden",
        "approval_required",
        "not_found",
        "conflict",
        "validation_failed",
        "rate_limited",
        "provider_unavailable",
        "operation_cancelled",
        "resume_unavailable",
        "protocol_version_unsupported",
        "internal"
      ]
    },
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": true,
        "message": {
          "type": "string"
        },
        "request_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "retry_after_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message",
        "retryable"
      ]
    },
    "FinalizeAttachmentRequest": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key",
        "sha256"
      ]
    },
    "MessageAuthor": {
      "type": "string",
      "enum": [
        "user",
        "bot",
        "system"
      ]
    },
    "MessageMutationRequest": {
      "type": "object",
      "properties": {
        "idempotency_key": {
          "type": "string",
          "format": "uuid"
        },
        "request_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "additionalProperties": false,
      "required": [
        "request_id",
        "idempotency_key"
      ]
    },
    "MessagePart": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "text"
            },
            "ordinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "ordinal",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attachment": {
              "$ref": "#/$defs/Attachment"
            },
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "attachment"
            },
            "ordinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            }
          },
          "required": [
            "kind",
            "id",
            "ordinal",
            "attachment"
          ]
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "kind": {
              "type": "string",
              "const": "notice"
            },
            "ordinal": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "id",
            "ordinal",
            "text"
          ]
        }
      ]
    },
    "MessageStatus": {
      "type": "string",
      "enum": [
        "queued",
        "streaming",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "MessageSummary": {
      "type": "object",
      "properties": {
        "author": {
          "$ref": "#/$defs/MessageAuthor"
        },
        "author_bot_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "chat_id": {
          "type": "string",
          "format": "uuid"
        },
        "completed_at_ms": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorEnvelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "mentioned_bot_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MessagePart"
          }
        },
        "reply_to_message_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "status": {
          "$ref": "#/$defs/MessageStatus"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "chat_id",
        "author",
        "status",
        "parts",
        "mentioned_bot_ids",
        "created_at_ms"
      ]
    },
    "ProtocolRange": {
      "type": "object",
      "properties": {
        "maximum": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minimum": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ]
    },
    "QueuedPromptSummary": {
      "type": "object",
      "properties": {
        "attachment_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "chat_id": {
          "type": "string",
          "format": "uuid"
        },
        "content": {
          "type": "string"
        },
        "created_at_ms": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "position": {
